DATABASE_URL="postgresql://postgres:password@localhost:5432/asisstdoc_?schema=public"
JWT_SECRET="your-super-secret-jwt-key"
PORT=3001
TZ="Asia/Jakarta"
CLIENT_URL="http://localhost:5173"
CLIENT_URLS="http://localhost:5173"
CONSULTATION_FEE=30000
ADMIN_FEE=5000
TAX_RATE=0.18

# Midtrans Payment Gateway Configuration
# Dapatkan Server Key & Client Key dari https://dashboard.midtrans.com/
# Sandbox: diawali "SB-Mid-..." | Production: diawali "Mid-..."
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxx"
MIDTRANS_IS_PRODUCTION=false
ALLOW_MOCK_PAYMENTS=true
