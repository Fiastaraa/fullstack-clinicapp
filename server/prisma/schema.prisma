generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DOCTOR
  NURSE
  PHARMACIST
  PATIENT
}

enum VisitStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  PAID
}

enum InvoiceStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  CASH
  TRANSFER
  E_WALLET
}

enum PrescriptionStatus {
  PENDING
  READY
}

enum ReminderType {
  KONTROL
  VAKSINASI
  CEK_LAB
}

enum ReminderStatus {
  PENDING
  SENT
  COMPLETED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient?
  doctor  Doctor?
}

model Poli {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors Doctor[]
  visits  Visit[]
}

model Patient {
  id        Int       @id @default(autoincrement())
  name      String
  nik       String?   @unique
  birthDate DateTime?
  gender    String
  age       Int
  phone     String
  address   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId    Int?       @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  visits    Visit[]
  reminders Reminder[]
}

model Doctor {
  id             Int      @id @default(autoincrement())
  name           String
  specialization String
  poliId         Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  poli   Poli?   @relation(fields: [poliId], references: [id], onDelete: SetNull)
  userId Int?    @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  visits Visit[]
}

model Visit {
  id                   Int         @id @default(autoincrement())
  patientId            Int
  doctorId             Int
  poliId               Int?
  queueNumber          String?
  estimatedWaitMinutes Int?
  visitDate            DateTime    @default(now())
  status               VisitStatus @default(WAITING)

  complaint     String?
  bloodPressure String?
  temperature   Float?
  weight        Float?
  height        Float?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  poli          Poli?          @relation(fields: [poliId], references: [id], onDelete: SetNull)
  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  invoice       Invoice?

  @@index([visitDate])
  @@index([status])
  @@index([patientId])
  @@index([doctorId])
  @@index([poliId])
}

model Diagnosis {
  id            Int     @id @default(autoincrement())
  visitId       Int
  diagnosisName String
  notes         String?

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Medicine {
  id        Int      @id @default(autoincrement())
  name      String
  dosage    String
  price     Decimal  @db.Decimal(12, 2)
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescriptions Prescription[]
}

model Prescription {
  id         Int                @id @default(autoincrement())
  visitId    Int
  medicineId Int
  quantity   Int
  status     PrescriptionStatus @default(PENDING)

  visit    Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visitId])
  @@index([medicineId])
  @@index([status])
}

model Invoice {
  id              Int           @id @default(autoincrement())
  visitId         Int           @unique
  consultationFee Decimal       @db.Decimal(12, 2)
  medicineTotal   Decimal       @db.Decimal(12, 2)
  adminFee        Decimal       @db.Decimal(12, 2)
  tax             Decimal       @db.Decimal(12, 2)
  subtotal        Decimal       @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  status          InvoiceStatus @default(UNPAID)

  visit    Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id        Int           @id @default(autoincrement())
  invoiceId Int
  method    PaymentMethod
  paidDate  DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Reminder {
  id        Int            @id @default(autoincrement())
  patientId Int
  type      ReminderType   @default(KONTROL)
  title     String
  date      DateTime
  notes     String?
  status    ReminderStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([date])
}
