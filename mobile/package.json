{
  "name": "assistdoc-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node --max-old-space-size=4096 node_modules/expo/bin/cli start",
    "start:lan": "node --max-old-space-size=4096 node_modules/expo/bin/cli start --clear --lan",
    "android": "node --max-old-space-size=4096 node_modules/expo/bin/cli start --android",
    "ios": "node --max-old-space-size=4096 node_modules/expo/bin/cli start --ios",
    "web": "node --max-old-space-size=4096 node_modules/expo/bin/cli start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~57.0.21",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
